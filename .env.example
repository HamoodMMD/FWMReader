# FWM's Claude Chat Archive Viewer
# Keep real paths private. Do not commit .env files.

# Optional override for development-only local storage.
# Defaults to the OS app-data directory in production and .local-data in dev.
ARCHIVE_VIEWER_DATA_DIR=.local-data

# Optional watched folders, comma-separated. The app never commits these paths.
ARCHIVE_VIEWER_WATCH_FOLDERS=

# AI integrations are disabled by default and should remain opt-in.
ARCHIVE_VIEWER_AI_ENABLED=false

